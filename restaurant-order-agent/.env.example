# Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# WhatsApp Cloud API — Meta for Developers > seu app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Qualquer string secreta escolhida por você; deve bater com a configurada no
# webhook do app Meta.
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto
WHATSAPP_API_VERSION=v20.0

# Dados do restaurante (usados no prompt do agente)
RESTAURANT_NAME=Pizzaria Bella Napoli
RESTAURANT_ADDRESS=Rua das Palmeiras, 123 - São Paulo, SP
RESTAURANT_PHONE=(11) 4444-5555

# Onde os pedidos ficam salvos
DATABASE_PATH=data/orders.db
